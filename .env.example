# COSMOS local inference. Point this at a GGUF model you own or are licensed to use.
COSMOS_MODEL_PATH=/absolute/path/to/cosmos-model.gguf
COSMOS_CONTEXT_SIZE=4096
COSMOS_DATA_DIR=~/.cosmos
COSMOS_HOST=127.0.0.1
COSMOS_PORT=8000
# Required before binding beyond localhost.
# COSMOS_API_TOKEN=replace-with-a-long-random-secret