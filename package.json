{
  "name": "cosmos-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bash scripts/run-local.sh",
    "dev:next": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "bash scripts/run-local.sh",
    "start:next": "next start --hostname 0.0.0.0",
    "lint": "eslint app components hooks lib tests types *.config.*",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"app/**/*.{ts,tsx,css}\" \"components/**/*.{ts,tsx}\" \"hooks/**/*.ts\" \"lib/**/*.ts\" \"tests/**/*.test.ts\" \"types/**/*.ts\" \"*.{json,md,mjs,ts}\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,css}\" \"components/**/*.{ts,tsx}\" \"hooks/**/*.ts\" \"lib/**/*.ts\" \"tests/**/*.test.ts\" \"types/**/*.ts\" \"*.{json,md,mjs,ts}\""
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.81",
    "@ai-sdk/react": "^4.0.161",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "ai": "^7.0.157",
    "framer-motion": "^14.8.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.64.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
